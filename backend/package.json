{
  "name": "gestor-turnos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
